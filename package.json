{
  "name": "blaze-engineering-company",
  "version": "0.1.0",
  "private": true,
  "description": "Blaze Billing: offline billing and inventory for BLAZE ENGINEERING COMPANY",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "node scripts/build.mjs",
    "app": "npm run build && electron .",
    "dist:win": "node scripts/prepare-native.mjs && npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^42.11.18",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "author": "BLAZE ENGINEERING COMPANY",
  "main": "dist/main/main.cjs",
  "build": {
    "appId": "com.blazeengineering.billing",
    "productName": "Blaze Billing",
    "copyright": "BLAZE ENGINEERING COMPANY",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "src/infrastructure/db/migrations",
        "to": "migrations",
        "filter": [
          "*.sql"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Blaze-Billing-Setup-${version}.${ext}"
    },
    "npmRebuild": false
  }
}
